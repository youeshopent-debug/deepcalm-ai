# DeepCalm AI — 环境变量模板
# 复制此文件为 .env.local 并填入真实值

# OpenAI API Key（用于 AI 心理补导师的语义分析）
# 申请地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# SiliconFlow API Key（用于 3D 环境音生成，后续功能）
# 申请地址：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# Resend API Key（用于发送订阅确认邮件）
# 申请地址：https://resend.com/api-keys
RESEND_API_KEY=

# 发件人地址（Resend 验证过的域名）
MAIL_FROM=DeepCalm AI <noreply@deepcalm-ai.com>

# 新订阅通知接收邮箱
MAIL_TO=alanlsl8208@gmail.com
